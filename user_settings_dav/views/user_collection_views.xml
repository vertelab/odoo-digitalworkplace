<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dav_user_collection_tree" model="ir.ui.view">
        <field name="name">dav.collection.user.tree</field>
        <field name="model">dav.collection</field>
        <field name="arch" type="xml">
            <list string="DAV Collections" delete="false" create="false">
                <field name="name"/>
                <field name="dav_type"/>
                <field name="domain"/>
                <field name="url" widget="copy_to_clipbord_url"/>
            </list>
        </field>
    </record>

    <record id="test-padge" model="ir.ui.view">
        <field name="model">res.users</field>
        <field name="priority" eval="1"/>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="user_collection" string="Calendar">
                    <field name="dav_collection_ids" view_ids="[(4, %(view_dav_user_collection_tree)d)]" mode="tree"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>