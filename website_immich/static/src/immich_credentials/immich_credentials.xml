<templates id="template" xml:space="preserve">
    <t t-name="website_immich.ImmichCredentials">
        <div class="d-flex align-items-center flex-wrap">
            <span class="me-1">Immich Server URL:</span>
            <input type="text"
                   class="o_input o_required_modifier form-control w-auto mx-2"
                   placeholder="https://photos.example.com"
                   t-model="state.url"
                   t-on-input="() => this.state.hasUrlError = false"
                   t-att-class="{ 'is-invalid': state.hasUrlError }"/>
            <span class="mx-1">API Key:</span>
            <input type="password"
                   class="o_input o_required_modifier form-control w-auto ms-2"
                   placeholder="Paste your API key here"
                   t-model="state.api_key"
                   t-on-input="() => this.state.hasKeyError = false"
                   t-att-class="{ 'is-invalid': state.hasKeyError }"/>
            <button type="button" class="btn btn-primary w-auto ms-3 p-auto save_immich" t-on-click="() => this.submitCredentials()">Apply</button>
        </div>
    </t>
</templates>
