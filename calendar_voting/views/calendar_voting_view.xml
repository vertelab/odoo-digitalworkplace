<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="calendar_voting_checkbox" model="ir.ui.view">
        <field name="name">calendar.event.form</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"></field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='recurrency']" position="after">
                <field name="voting_checkbox" invisible="is_voting_admin == False"></field>
                <field name="user_id" readonly="1" string="Voting admin" invisible="voting_checkbox == False"></field>
                <field name="choose_day_calendar" widget="date" invisible="(voting_checkbox == False or is_voting_admin == False)"></field>
                <field name="choose_this_day" invisible="(voting_checkbox == False or is_voting_admin == False)"></field>
                <field name="is_voting_admin" invisible="1"></field>
                <field name="showtime" string="Voting time" readonly="1" invisible="voting_checkbox == False"></field>
            </xpath>
            <xpath expr="//page[@name='page_options']" position="inside">
                <div invisible="voting_checkbox == False">
                    <field name="participant_ids" mode="tree,kanban">
                        <list string="Invitation details" editable="bottom" delete="false" create="false">
                            <field name="name"/>
                            <field name="monday"/>
                            <field name="tuesday" />
                            <field name="wednesday" />
                            <field name="thursday" />
                            <field name="friday" />
                        </list>
                    </field>
                    <ul style="list-style-type:none">
                        <li> Link to voting site:
                            <field name="calendar_access" widget="url"/>
                        </li>
                    </ul>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
