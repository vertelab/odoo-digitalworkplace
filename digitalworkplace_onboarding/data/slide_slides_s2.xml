    <!-- SLIDE 2.1: Chatt och möte — första gången -->
    <record id="slide_dw_s2_01" model="slide.slide">
        <field name="name">Första gången — chatt och möte</field>
        <field name="sequence">110</field>
        <field name="slide_category">article</field>
        <field name="channel_id" ref="digitalworkplace_onboarding.slide_channel_digitalworkplace"/>
